{
  "manifest_version": 3,
  "name": "AEGIS ChatGPT Bridge",
  "version": "0.1.0",
  "description": "Open ChatGPT research prompts and conversations from Chrome or Edge.",
  "permissions": ["activeTab", "contextMenus"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "AEGIS ChatGPT Bridge", "default_popup": "popup.html" }
}
