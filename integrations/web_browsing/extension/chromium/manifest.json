{
  "manifest_version": 3,
  "name": "AEGIS Web Companion",
  "version": "0.1.0",
  "description": "Send the current public page URL to ChatGPT for user-directed research.",
  "permissions": [
    "activeTab",
    "contextMenus"
  ],
  "action": {
    "default_title": "Research with AEGIS",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
